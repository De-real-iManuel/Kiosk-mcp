# ── Stage 1: install all deps ───────────────────────────────────────────────
FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/db/package.json               ./lib/db/
COPY lib/api-zod/package.json          ./lib/api-zod/
COPY lib/api-spec/package.json         ./lib/api-spec/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY artifacts/kiosk-frontend/package.json ./artifacts/kiosk-frontend/

RUN pnpm install --frozen-lockfile --ignore-scripts

# ── Stage 2: build Next.js ───────────────────────────────────────────────────
FROM base AS builder
COPY tsconfig.json tsconfig.base.json ./
ENV NEXT_TELEMETRY_DISABLED=1

COPY lib/                   ./lib/
COPY artifacts/kiosk-frontend/ ./artifacts/kiosk-frontend/

# Build lib declarations (needed by frontend typecheck at build time)
RUN pnpm run typecheck:libs

# Build the Next.js app
# NEXT_PUBLIC_* vars must be baked in at build time
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN pnpm --filter @workspace/kiosk-frontend build

# ── Stage 3: production runner ───────────────────────────────────────────────
FROM node:20-alpine AS runner
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/db/package.json               ./lib/db/
COPY lib/api-zod/package.json          ./lib/api-zod/
COPY lib/api-spec/package.json         ./lib/api-spec/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY artifacts/kiosk-frontend/package.json ./artifacts/kiosk-frontend/

RUN pnpm install --frozen-lockfile --ignore-scripts --prod

# Copy Next.js build output
COPY --from=builder /app/artifacts/kiosk-frontend/.next     ./artifacts/kiosk-frontend/.next
COPY --from=builder /app/artifacts/kiosk-frontend/public    ./artifacts/kiosk-frontend/public
COPY --from=builder /app/artifacts/kiosk-frontend/next.config.ts ./artifacts/kiosk-frontend/

EXPOSE 3000
ENV PORT=3000

CMD ["pnpm", "--filter", "@workspace/kiosk-frontend", "serve"]
