auto-install-peers=false
strict-peer-dependencies=false
enable-pre-post-scripts=true

# Disable strict build script enforcement so pnpm install never fails on CI
# due to ERR_PNPM_IGNORED_BUILDS. The allowBuilds / onlyBuiltDependencies
# lists in pnpm-workspace.yaml remain the authoritative allow-list.
strict-dep-builds=false
