{
    "name":  "@workspace/db",
    "version":  "0.0.0",
    "private":  true,
    "type":  "module",
    "exports":  {
                    ".":  "./src/index.ts",
                    "./schema":  "./src/schema/index.ts"
                },
    "scripts":  {
                    "push":  "drizzle-kit push --config ./drizzle.config.ts",
                    "push-force":  "drizzle-kit push --force --config ./drizzle.config.ts",
                    "seed":  "tsx --env-file=.env src/seed/index.ts",
                    "test":  "vitest run"
                },
    "dependencies":  {
                         "date-fns":  "^4.4.0",
                         "date-fns-tz":  "^3.2.0",
                         "drizzle-orm":  "catalog:",
                         "drizzle-zod":  "^0.8.3",
                         "pg":  "^8.23.0",
                         "zod":  "catalog:"
                     },
    "devDependencies":  {
                            "@types/node":  "catalog:",
                            "@types/pg":  "^8.23.1",
                            "drizzle-kit":  "^0.31.10",
                            "tsx":  "catalog:",
                            "vitest":  "^2.1.0",
                            "fast-check":  "^3.22.0"
                        }
}
