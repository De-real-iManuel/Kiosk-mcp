{
    "name": "workspace",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "preinstall": "node -e \"const a=process.env.npm_config_user_agent||'';if(!a.startsWith('pnpm/')){process.stderr.write('Use pnpm instead\\n');process.exit(1)}['package-lock.json','yarn.lock'].forEach(f=>{try{require('fs').unlinkSync(f)}catch{}})\"",
        "build": "pnpm run typecheck && pnpm -r --if-present run build",
        "typecheck:libs": "tsc --build",
        "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
        "e2e": "pnpm --filter @workspace/scripts run e2e"
    },
    "private": true,
    "devDependencies": {
        "prettier": "^3.9.6",
        "typescript": "~5.9.3"
    },
    "optionalDependencies": {
        "@esbuild/win32-x64": "0.28.2",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    }
}