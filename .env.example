# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/kiosk

# ─── Supabase (optional — if using Supabase dashboard) ────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Clerk Authentication ──────────────────────────────────────────────────────
# Server-side key used by api-server and business-mcp
CLERK_SECRET_KEY=sk_test_...
# Publishable key used by api-server middleware and the frontend
CLERK_PUBLISHABLE_KEY=pk_test_...
# Exposed to the browser — must match CLERK_PUBLISHABLE_KEY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ─── Service URLs ──────────────────────────────────────────────────────────────
# API server base URL (used by the frontend client)
NEXT_PUBLIC_API_URL=http://localhost:4000

# MCP server base URL — no trailing slash.
# In production set to your public MCP host, e.g. https://mcp.kiosk.example
MCP_BASE_URL=http://localhost:5001
# Frontend public var — must match MCP_BASE_URL
NEXT_PUBLIC_MCP_BASE_URL=http://localhost:5001

# ─── Amazon Bedrock ────────────────────────────────────────────────────────────
# Set to "true" to enable Titan Embeddings V2 semantic search in master-mcp.
# Requires valid AWS credentials (AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY,
# or an IAM role on ECS). Falls back to SQL keyword search when false.
BEDROCK_ENABLED=false
AWS_REGION=us-east-1

# ─── Service Ports ─────────────────────────────────────────────────────────────
# api-server listens on this port (default 4000)
PORT=4000
# business-mcp listens on this port (default 5001)
MCP_PORT=5001

# ─── Logging ───────────────────────────────────────────────────────────────────
# One of: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
# Set to "production" to disable pino-pretty and enable JSON logs
NODE_ENV=development

# ─── AWS (production deployment only) ─────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
